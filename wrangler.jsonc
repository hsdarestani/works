{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "works",
  "main": "translation-worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "a-plus-works",
      "database_id": "cccba219-9ba8-4b4e-939e-7e46e66957d8"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "GITHUB_REPOSITORY": "hsdarestani/works",
    "GITHUB_BRANCH": "assets"
  },
  "observability": {
    "enabled": true
  }
}